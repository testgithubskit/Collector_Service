def check_for_mount_drive(directory: Path):
    """

    :return:
    :rtype:
    """

    command_to_mount = ["sudo", "mount", "-t", "cifs", "-o", "username=SMDDC,password=Toyota_2022",
                        "//172.18.20.27/www", "/mnt/win_share"]
    command_to_ping = ["ping", "-c", "1", "172.18.20.27"]
    host_status = subprocess.call(command_to_ping)
    if host_status != 0:
        raise ConnectionError("Host 172.18.20.27 is unreachable, try again!")

    if not os.path.exists(directory):
        return False
    return True


