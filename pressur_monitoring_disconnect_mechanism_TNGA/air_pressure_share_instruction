  --name pressure_machine_1 \
  -v /mnt/pressure_data/2nd-rough:/mnt/pressure_data/2nd-rough \
  pressure_collector:latest \
  python air_pressure_data_shared.py \
      --os linux \
      --machine_id 1 \
      --mount_location "/mnt/pressure_data/2nd-rough" \
      --skip_mount


